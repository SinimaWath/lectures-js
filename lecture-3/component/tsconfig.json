{
  "compilerOptions": {
    // До какой версии JavaScript TypeScript будет ориентироваться.
    // ES2022 позволяет использовать современные возможности языка без лишних ограничений.
    "target": "ES2022",

    // Используем современную модульную систему ES modules: import / export.
    // Именно такой формат обычно используется во фронтенд-проектах.
    "module": "ESNext",

    // Подсказываем TypeScript, как искать и понимать импорты в проекте с Vite.
    // Без этого могут появляться ошибки даже при правильном коде.
    "moduleResolution": "Bundler",

    // Подключаем встроенные типы:
    // ES2022 - типы современного JavaScript,
    // DOM - типы для document, element, button и других браузерных объектов,
    // DOM.Iterable - поддержка перебора DOM-коллекций.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Включаем строгий режим.
    // Это главная настройка для обучения TypeScript: она заставляет писать код точнее и ловит больше ошибок.
    "strict": true,

    // Не создаем отдельные .js-файлы через TypeScript.
    // Здесь TypeScript только проверяет типы, а сборкой занимается Vite.
    "noEmit": true,

    // Не проверяем типы внутри библиотек из node_modules.
    // Это ускоряет работу проекта и не отвлекает от ошибок в вашем коде.
    "skipLibCheck": true,

    // Показываем ошибку, если вы создали переменную, но нигде ее не используете.
    // Это помогает замечать лишний или незаконченный код.
    "noUnusedLocals": true,

    // Показываем ошибку, если у функции есть параметр, который не используется.
    // Полезно, чтобы сигнатуры функций оставались понятными.
    "noUnusedParameters": true,

    // Запрещаем случайный переход из одного case в другой внутри switch.
    // Такая ошибка часто бывает незаметной, поэтому лучше ловить ее сразу.
    "noFallthroughCasesInSwitch": true
  },

  // Проверяем только файлы из папки src.
  // Это основная папка с исходным кодом приложения.
  "include": ["src"]
}
