{
  "compilerOptions": {
    // До какой версии JavaScript TypeScript будет ориентироваться при компиляции.
    // ES2022 уже поддерживает современный синтаксис и подходит для учебных примеров.
    "target": "ES2022",

    // Указываем, что проект использует современную модульную систему import / export.
    // Это стандартный вариант для фронтенд-проектов.
    "module": "ESNext",

    // Объясняем TypeScript, как искать и обрабатывать импорты в проекте.
    // Настройка Bundler хорошо подходит для современных сборщиков.
    "moduleResolution": "Bundler",

    // Включаем строгую проверку типов.
    // Это главная настройка для изучения TypeScript, потому что она помогает раньше замечать ошибки.
    "strict": true,

    // Папка, куда TypeScript складывает готовые JavaScript-файлы после компиляции.
    "outDir": "./dist",

    // Папка с исходными TypeScript-файлами.
    // TypeScript будет брать код именно отсюда.
    "rootDir": "./src",

    // Не проверяем типы внутри библиотек из node_modules.
    // Это ускоряет работу и позволяет сосредоточиться на собственном коде.
    "skipLibCheck": true
  },

  // Проверяем все TypeScript-файлы внутри папки src.
  "include": ["src/**/*.ts"]
}